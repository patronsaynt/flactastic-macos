{
  "description": "Multi-value tag parsing cases, language-neutral. Each case resolves one field. 'native' is the singular tag's values as the container stores them; 'plural' the ARTISTS/ALBUMARTISTS values; 'known' the names that already exist on their own in the library; 'mbidCount' the number of MusicBrainz artist IDs; 'decision' a saved review answer ('keep' or a list). 'expected' is the resulting list, or the string 'review' when the raw value is kept whole and queued. 'generated' builds oversized input: longValue (one value of 'length' characters) or manyValues ('count' values); 'expectedLengths' / 'expectedCount' check the caps (1024 characters, 50 values).",
  "cases": [
    { "name": "spaced semicolon", "field": "artist", "native": ["a ; b"], "expected": ["a", "b"] },
    { "name": "bare semicolon", "field": "artist", "native": ["a;b"], "expected": ["a", "b"] },
    { "name": "semicolon then space", "field": "artist", "native": ["Deadmau5; Kaskade"], "expected": ["Deadmau5", "Kaskade"] },
    { "name": "backslash", "field": "artist", "native": ["a\\b"], "expected": ["a", "b"] },
    { "name": "double backslash", "field": "artist", "native": ["a\\\\b"], "expected": ["a", "b"] },
    { "name": "spaced slash is safe", "field": "artist", "native": ["Deadmau5 / Rob Swire"], "expected": ["Deadmau5", "Rob Swire"] },
    { "name": "NUL separator", "field": "artist", "native": ["a\u0000b"], "expected": ["a", "b"] },
    { "name": "native multi-values", "field": "artist", "native": ["A Tribe Called Quest", "Busta Rhymes"], "expected": ["A Tribe Called Quest", "Busta Rhymes"] },
    { "name": "native values are taken as is", "field": "artist", "native": ["Simon & Garfunkel", "Paul Simon"], "expected": ["Simon & Garfunkel", "Paul Simon"] },
    { "name": "plural tag takes precedence", "field": "artist", "plural": ["Kaskade", "Deadmau5"], "native": ["Kaskade feat. Deadmau5"], "expected": ["Kaskade", "Deadmau5"] },
    { "name": "plural tag with one value", "field": "artist", "plural": ["Simon & Garfunkel"], "native": ["Simon & Garfunkel"], "expected": ["Simon & Garfunkel"] },
    { "name": "AC/DC", "field": "artist", "native": ["AC/DC"], "expected": "review" },
    { "name": "AC/DC kept by decision", "field": "artist", "native": ["AC/DC"], "decision": "keep", "expected": ["AC/DC"] },
    { "name": "Simon & Garfunkel", "field": "artist", "native": ["Simon & Garfunkel"], "expected": "review" },
    { "name": "Earth, Wind & Fire", "field": "artist", "native": ["Earth, Wind & Fire"], "known": ["Earth", "Wind"], "expected": "review" },
    { "name": "Tyler, the Creator", "field": "artist", "native": ["Tyler, the Creator"], "expected": "review" },
    { "name": "both parts known", "field": "artist", "native": ["Host & Guest"], "known": ["Host", "Guest"], "expected": ["Host", "Guest"] },
    { "name": "feat. with both parts known", "field": "artist", "native": ["Host feat. Guest"], "known": ["host", "GUEST"], "expected": ["Host", "Guest"] },
    { "name": "accepted by MusicBrainz ID count", "field": "artist", "native": ["Calvin Harris & Dua Lipa"], "mbidCount": 2, "expected": ["Calvin Harris", "Dua Lipa"] },
    { "name": "MusicBrainz ID count mismatch", "field": "artist", "native": ["Calvin Harris & Dua Lipa"], "mbidCount": 3, "expected": "review" },
    { "name": "split by decision", "field": "artist", "native": ["Unknown One, Unknown Two"], "decision": ["Unknown One", "Unknown Two"], "expected": ["Unknown One", "Unknown Two"] },
    { "name": "album artist uses the same rule", "field": "albumArtist", "native": ["Jay-Z & Kanye West"], "expected": "review" },
    { "name": "whitespace and empty values", "field": "artist", "native": ["  a ;; ; b  "], "expected": ["a", "b"] },
    { "name": "empty native values", "field": "artist", "native": ["", " a ", "b", "  "], "expected": ["a", "b"] },
    { "name": "nothing at all", "field": "artist", "native": [], "expected": [] },
    { "name": "case-insensitive duplicates", "field": "artist", "native": ["Daft Punk ; daft punk ; DAFT PUNK"], "expected": ["Daft Punk"] },
    { "name": "genre never uses the ambiguous rule", "field": "genre", "native": ["Drum & Bass"], "expected": ["Drum & Bass"] },
    { "name": "genre with a comma stays whole", "field": "genre", "native": ["Rock, Pop"], "known": ["Rock", "Pop"], "expected": ["Rock, Pop"] },
    { "name": "genre safe split", "field": "genre", "native": ["Rock ; Pop"], "expected": ["Rock", "Pop"] },
    { "name": "native genres", "field": "genre", "native": ["Hip-Hop", "Jazz Rap"], "expected": ["Hip-Hop", "Jazz Rap"] },
    { "name": "oversized value is truncated", "field": "artist", "generated": { "kind": "longValue", "length": 5000 }, "expectedLengths": [1024] },
    { "name": "too many values are capped", "field": "artist", "generated": { "kind": "manyValues", "count": 80 }, "expectedCount": 50 }
  ]
}
